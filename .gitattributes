# Git Large File Storage (LFS) — use only for large video; GitHub Pages does not serve LFS blobs for images.
*.mov filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text
*.mkv filter=lfs diff=lfs merge=lfs -text
# Regular text files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.xml text eol=lf
# Original large video stays in LFS
assets/echofinal.mp4 filter=lfs diff=lfs merge=lfs -text
# Compressed video is regular file (under 100MB limit for GitHub Pages)
assets/echofinal_compressed.mp4 -filter -diff -merge text=false
